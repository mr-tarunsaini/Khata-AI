# ==============================================================================
# KhataAI Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application Mode: 'demo' (mock services for evaluation) or 'production' (live cloud APIs)
VITE_APP_MODE=demo

# Supabase Cloud Database & Authentication (Browser-Safe Anon Keys ONLY)
# NEVER put service_role key here!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Voice Gateway Endpoint (for secret-bearing speech & LLM requests)
VITE_VOICE_GATEWAY_URL=http://localhost:3001/api/voice

# Server-Side API Keys (Used ONLY by server gateway / edge functions, never in client bundle)
# GNANI_API_KEY=your_gnani_prisma_api_key_here
# GNANI_TOKEN=your_gnani_timbre_token_here
# GEMINI_API_KEY=your_google_gemini_api_key_here
